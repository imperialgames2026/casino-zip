# Public browser-safe Supabase configuration only. Never put service-role or Sumsub secrets in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Disabled until Sumsub sandbox, signed webhook, privacy notice, and provider policies are verified.
VITE_KYC_DOCUMENTS_ENABLED=false
VITE_KYC_PHONE_SMS_ENABLED=false
VITE_KYC_PRIVACY_URL=
